node_modules/

# Runtime state the app writes. These are globs, not exact names: the data root
# moves with THREADSHELF_PATH / --collection, so `.threadshelf-demo/`,
# `.lancedb-test/` and friends must be covered without editing this file again.
.threadshelf*/
.lancedb*/
.uploads*/
.tmp-*/
.collections.json
test-results/
playwright-report/
.playwright-mcp/

# Vector-store and model-cache artifacts, in case one is written outside the
# directories above. A 130 MB LanceDB tree once reached the index this way.
*.lance/
*.txn
*.manifest
*.onnx
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
dist/
.cache/
.claude/
.codex/
client/node_modules/
client/tsconfig.tsbuildinfo
# Built web UI output (regenerated by `npm run build:client`). The source
# lives in client/; client/public/ (favicon, static assets) IS committed.
/public/

# Data and exports (ignore raw user data)
# Keep private chat exports out of git. Put anything sensitive under these:
DO_NOT_COMMIT/
private/
exports/
Google AI Studio/
anthropic/
openai/
data/
